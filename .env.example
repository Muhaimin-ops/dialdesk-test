# ───────── Required ─────────
# Public canonical app origin. Required in production; use HTTPS and no trailing path.
APP_URL=http://localhost:3000
DIALDESK_APP_URL=http://localhost:3000
# Random string, 32+ chars. Signs widget + call tokens.  openssl rand -base64 48
APP_SECRET=
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ───────── Optional ─────────
VOICE_PIPELINE_URL=http://127.0.0.1:7860
# The voice service uses Groq for Whisper transcription, Ollama for the LLM, and local Kokoro for TTS.
GROQ_API_KEY=
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=gemma3:1b
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.1
FREE_CALLS_PER_MONTH=20
PRO_CALLS_PER_MONTH=500
# Max length of a single call in seconds (client enforces; default 600)
MAX_CALL_SECONDS=600

# Stripe billing (leave empty to disable the upgrade button)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Booking confirmation emails via Resend (leave empty to disable)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Acme Reception <bookings@yourdomain.com>
